# Copy this file to .env and fill in your values.

# Discord bot token from https://discord.com/developers/applications
# (Bot -> Reset Token). Enable the "Message Content" privileged intent for the bot.
DISCORD_BOT_TOKEN=

# Optional overrides
# LLM_SERVICE_PORT=3730
# BACKEND_PORT=8730
# METIS_CONFIG=C:\path\to\other-config.yaml
# METIS_MEMORY_DIR=C:\path\to\memory
